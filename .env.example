# Server-only settings. Copy to .env.local for development, or set in the host.
# Use a unique password (at least 12 characters) and a random session secret
# (at least 32 characters). Never use a NEXT_PUBLIC_ prefix for these values.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Required in production. Apply supabase/applications.sql before launching.
# Development without Supabase saves records in the git-ignored .data directory.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service_role JWT keys are also supported when SECRET_KEY is unset.
SUPABASE_SERVICE_ROLE_KEY=

# Optional notification after the registration has been saved.
SUBMISSIONS_WEBHOOK_URL=

# AI Radar reuses the storage/admin settings above.
# Run supabase/ai-radar.sql and then seed/import before deploying.
# Daily Vercel refresh at 03:00 UTC; optional Node worker runs every six hours.
CRON_SECRET=
# Development defaults to local files. Set supabase to exercise connected data.
# RADAR_STORAGE=supabase
# Optional self-hosted Ollama bilingual drafts; all generated drafts need review.
# No inference service is called when these settings are absent.
# RADAR_OLLAMA_URL=http://127.0.0.1:11434
# RADAR_OLLAMA_MODEL=your-installed-multilingual-model
