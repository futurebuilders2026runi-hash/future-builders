# Server-only settings. Copy to .env.local for development, or set in the host.
# Use a unique password (at least 12 characters) and a random session secret
# (at least 32 characters). Never use a NEXT_PUBLIC_ prefix for these values.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Required in production. Apply supabase/applications.sql before launching.
# Development without Supabase saves records in the git-ignored .data directory.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional notification after the registration has been saved.
SUBMISSIONS_WEBHOOK_URL=
